# ─────────────────────────────────────────────────────────────────────────────
# SOC Agent — .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets — NEVER commit these ─────────────────────────────────────────────
.env
*.pem
*.key
*.p12
*.pfx

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.venv/
venv/
env/
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.whl

# ── Alembic ───────────────────────────────────────────────────────────────────
# Keep migrations/ tracked; ignore only local overrides
migrations/versions/__pycache__/

# ── Testing ──────────────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/
*.xml
.hypothesis/

# ── IDEs ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Docker ───────────────────────────────────────────────────────────────────
# Keep docker-compose files tracked; ignore override files
docker-compose.override.yml

# ── Node / Next.js ────────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local
frontend/.env.development.local
frontend/.env.test.local
frontend/.env.production.local

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Generated outputs ────────────────────────────────────────────────────────
reports/generated/
*.pdf
