# ─────────────────────────────────────────────────────────────────────────────
# SOC Agent — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is in .gitignore — NEVER commit it.
# This file (.env.example) IS committed — keep it up to date.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker Infrastructure (docker-compose.infra.yml) ─────────────────────────
# These are read by Docker Compose to create the containers.
# They must match the connection strings below.
POSTGRES_USER=soc_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=soc_db
POSTGRES_PORT=5432              # change if 5432 is taken on your machine

REDIS_PASSWORD=change_me_in_production
REDIS_PORT=6379                 # change if 6379 is taken on your machine

PGADMIN_EMAIL=admin@soc.local   # login for pgAdmin UI (optional tool)
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

REDIS_COMMANDER_PORT=8081       # port for Redis Commander UI (optional tool)

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME="SOC Agent"
APP_VERSION="0.1.0"
ENVIRONMENT=development         # development | staging | production
DEBUG=false

# ── PostgreSQL ────────────────────────────────────────────────────────────────
# IMPORTANT: must use postgresql+asyncpg:// scheme — plain postgresql:// will fail
# Values must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above
DATABASE_URL=postgresql+asyncpg://soc_user:change_me_in_production@localhost:5432/soc_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_ECHO_SQL=false               # set true only for local SQL debugging

# ── Redis ─────────────────────────────────────────────────────────────────────
# Password must match REDIS_PASSWORD above
REDIS_URL=redis://:change_me_in_production@localhost:6379/0
REDIS_CVE_QUEUE_NAME=cve_pipeline_queue
REDIS_LAST_POLL_KEY_NVD=a1:last_poll:nvd
REDIS_LAST_POLL_KEY_OSV=a1:last_poll:osv
REDIS_LAST_POLL_KEY_GITHUB=a1:last_poll:github_advisory

# ── NVD API v2 ────────────────────────────────────────────────────────────────
# Get a free API key at: https://nvd.nist.gov/developers/request-an-api-key
# Without key: 5 req/30s  |  With key: 50 req/30s
NVD_API_BASE_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
NVD_API_KEY=                    # leave blank if you don't have one yet
NVD_RESULTS_PER_PAGE=100

# ── OSV.dev API ───────────────────────────────────────────────────────────────
OSV_API_BASE_URL=https://api.osv.dev/v1
OSV_BULK_DOWNLOAD_URL=https://osv-vulnerabilities.storage.googleapis.com

# ── GitHub ────────────────────────────────────────────────────────────────────
# Required scopes: read:packages, read:org, public_repo (for Code Search in A3)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_token_here
GITHUB_GRAPHQL_URL=https://api.github.com/graphql
GITHUB_REST_API_URL=https://api.github.com

# ── CISA KEV (used by A3, not A1) ────────────────────────────────────────────
CISA_KEV_URL=https://www.cisa.gov/sites/default/files/feeds/known_exploited_vulnerabilities.json

# ── Exploit-DB (used by A3) ───────────────────────────────────────────────────
EXPLOITDB_CSV_URL=https://gitlab.com/exploit-database/exploitdb/-/raw/main/files_exploits.csv

# ── APScheduler ───────────────────────────────────────────────────────────────
SCHEDULER_POLL_INTERVAL_MINUTES=15
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_INSTANCES=1

# ── HTTP / Resilience ─────────────────────────────────────────────────────────
HTTP_TIMEOUT_SECONDS=30.0
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_JITTER_FACTOR=0.25

# ── API Pagination ────────────────────────────────────────────────────────────
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ── CORS (Member 3 — Next.js frontend) ───────────────────────────────────────
# JSON array syntax required for multiple origins
CORS_ORIGINS=["http://localhost:3000"]

# ── Anthropic / Claude (Member 2 — A4 Planner) ───────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ── JIRA (Member 3 — A5 Reporter) ────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_USER_EMAIL=your@email.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=SOC
JIRA_ISSUE_TYPE=Bug

# ── Slack (Member 3 — A5 Reporter) ───────────────────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
SLACK_ALERT_CHANNEL=#security-alerts

# ── Email / SMTP (Member 3 — A5 Reporter) ────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_app_password     # use App Password, not account password
SMTP_FROM_ADDRESS=soc-agent@your-org.com
